GRAPHRAG_ENVIRONMENT=local
GRAPHRAG_DATABASE_URL=postgresql+asyncpg://graphrag:graphrag@localhost:5432/graphrag
GRAPHRAG_SQL_ECHO=false
GRAPHRAG_CHUNK_MAX_CHARACTERS=2000
GRAPHRAG_EMBEDDING_PROVIDER=ollama
GRAPHRAG_EMBEDDING_BASE_URL=http://host.docker.internal:11434
GRAPHRAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
GRAPHRAG_EMBEDDING_DIMENSION=1024
GRAPHRAG_EMBEDDING_BATCH_SIZE=16
GRAPHRAG_EMBEDDING_TIMEOUT_SECONDS=300
GRAPHRAG_LLM_PROVIDER=ollama
GRAPHRAG_LLM_BASE_URL=http://host.docker.internal:11434
GRAPHRAG_LLM_MODEL=qwen3:4b
GRAPHRAG_LLM_TIMEOUT_SECONDS=300
GRAPHRAG_LLM_MAX_INPUT_CHARACTERS=200000
# For the optional paid OpenAI provider, set the provider names to openai,
# restore the OpenAI base URLs/models/dimension, and configure these keys:
# GRAPHRAG_EMBEDDING_API_KEY=
# GRAPHRAG_LLM_API_KEY=
# GRAPHRAG_LLM_API_KEY=
GRAPHRAG_NEO4J_URI=neo4j://localhost:7687
GRAPHRAG_NEO4J_USER=neo4j
GRAPHRAG_NEO4J_PASSWORD=graphrag-password
GRAPHRAG_NEO4J_DATABASE=neo4j
GRAPHRAG_REDIS_URL=redis://localhost:6379/0
GRAPHRAG_CELERY_BROKER_URL=redis://localhost:6379/0
GRAPHRAG_CELERY_RESULT_BACKEND=redis://localhost:6379/1
GRAPHRAG_INGESTION_DATA_ROOT=data
GRAPHRAG_PDF_MAX_FILE_SIZE_MB=25

GRAPHRAG_SEARCH_CANDIDATE_POOL_SIZE=100
GRAPHRAG_VECTOR_SEARCH_LIMIT=100
GRAPHRAG_GRAPH_SEARCH_LIMIT=100
GRAPHRAG_MAX_GRAPH_HOPS=3
GRAPHRAG_RANKING_SEMANTIC_WEIGHT=0.30
GRAPHRAG_RANKING_SKILL_WEIGHT=0.25
GRAPHRAG_RANKING_DOMAIN_WEIGHT=0.15
GRAPHRAG_RANKING_EXPERIENCE_WEIGHT=0.10
GRAPHRAG_RANKING_GRAPH_WEIGHT=0.10
GRAPHRAG_RANKING_LOCATION_WEIGHT=0.05
GRAPHRAG_RANKING_PREFERENCE_WEIGHT=0.05

POSTGRES_DB=graphrag
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=graphrag
